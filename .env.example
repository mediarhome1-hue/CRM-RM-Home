# Configurações do Supabase para o CRM Líder
# Renomeie este arquivo para .env.local e insira as credenciais do seu projeto Supabase

NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui

# Configurações do SMTP de E-mail (Gmail)
SMTP_USER=medialiderimobiliaria@gmail.com
SMTP_PASSWORD=insira-sua-senha-de-app-do-gmail-aqui

# Configurações da API Meta (Facebook Lead Ads & WhatsApp Cloud API)
FACEBOOK_ACCESS_TOKEN=seu_access_token_do_meta_aqui
FACEBOOK_VERIFY_TOKEN=crm_lider_facebook_token
WHATSAPP_PHONE_NUMBER_ID=seu_phone_number_id_do_whatsapp_aqui
WHATSAPP_ACCESS_TOKEN=seu_user_ou_system_access_token_do_whatsapp_aqui
WHATSAPP_VERIFY_TOKEN=crm_lider_token_default
